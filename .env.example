# ---------------------------------------------------------------------------
# F3 Nation API (https://api.f3nation.com/docs)
# Auth = `Authorization: Bearer <F3_API_KEY>` + `Client: <F3_API_CLIENT>`.
# Both headers are required; keys come from https://admin.f3nation.com/api-keys
# ---------------------------------------------------------------------------
F3_API_KEY=your_f3_api_key_here
# F3_API_URL=https://api.f3nation.com
# F3_API_CLIENT=password-vault-sync

# Vaultwarden Instance Base URL
VAULTWARDEN_URL=https://passwords.f3nation.com

# User API Credentials (Found in Vaultwarden Profile -> Account Settings -> Security -> Keys -> View API key)
VAULTWARDEN_CLIENT_ID=user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VAULTWARDEN_CLIENT_SECRET=your_user_api_secret_here
VAULTWARDEN_ORG_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Base64 organization key (encrypts collection names; required by the `orgs`
# task, ignored by `users`). Generate it once with:
#   uv run python scripts/extract_org_key.py --email you@example.com
# VAULTWARDEN_ORG_KEY=

# Email used by scripts/extract_org_key.py (PBKDF2 salt for your master key)
# VW_EMAIL=you@example.com

# Optional: default members CSV path for add_members_to_collection.py
# (a header row with an 'email' column and optional 'permission' column)
# MEMBERS_CSV_PATH=/path/to/members.csv
